{
  "name": "SuckFy",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "dev": "react-native start --verbose",
    "dev:ios": "npm-run-all --parallel dev ios",
    "dev:android": "npm-run-all --parallel dev android",
    "logs:ios": "xcrun simctl spawn booted log stream --predicate 'processImagePath endswith \"SuckFy\"' --level=debug",
    "logs:android": "adb logcat -s ReactNativeJS:V ReactNative:V SuckFy:V",
    "reset": "watchman watch-del-all && rm -rf $TMPDIR/react-* && react-native start --reset-cache",
    "build:android": "./BUILD_ANDROID.sh",
    "build:android:debug": "cd android && ./gradlew assembleDebug && cd ..",
    "build:android:release": "cd android && ./gradlew assembleRelease && cd ..",
    "clean:android": "cd android && ./gradlew clean && cd ..",
    "device:list": "adb devices -l",
    "device:menu": "adb shell input keyevent 82"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native/new-app-screen": "0.84.1",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/stack": "^7.8.5",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-background-timer": "^2.4.1",
    "react-native-fs": "^2.20.0",
    "react-native-saf-x": "^2.2.3",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-sound": "^0.13.0",
    "react-native-svg": "^15.15.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-react-inline-elements": "^7.27.1",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "npm-run-all": "^4.1.5",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 20.19.4"
  }
}
